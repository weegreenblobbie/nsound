"""embedded_python: where a C++ program finds Bazel's Python and packages.

Plotter starts a Python interpreter in C++ programs to plot with matplotlib.
This rule writes a C++ file with the runfiles paths of the Python
toolchain's interpreter and home and of the deps' import folders (their
site-packages), and puts those files in the program's runfiles.  Plotter.cc
looks the paths up with the C++ runfiles library.
"""

load("@rules_python//python:py_info.bzl", "PyInfo")

def _rlocation(ctx, file):
    """Returns the path of file that Runfiles::Rlocation() takes."""
    if file.short_path.startswith("../"):
        return file.short_path[len("../"):]

    return ctx.workspace_name + "/" + file.short_path

def _embedded_python_impl(ctx):
    runtime = ctx.toolchains["@rules_python//python:toolchain_type"].py3_runtime

    # The interpreter is <home>/bin/python3 on Linux and macOS, and
    # <home>/python.exe on Windows.
    interpreter = _rlocation(ctx, runtime.interpreter)
    home = interpreter.rpartition("/")[0]
    if home.endswith("/bin"):
        home = home[:-len("/bin")]

    imports = depset(
        transitive = [dep[PyInfo].imports for dep in ctx.attr.deps],
    ).to_list()

    lines = [
        "// Generated by //bazel:embedded_python.bzl for " + str(ctx.label) + ".",
        "",
        "namespace Nsound",
        "{",
        "",
        "//! The runfiles path of the Python interpreter, a link to Bazel's copy.",
        "extern const char * const EMBEDDED_PYTHON_INTERPRETER;",
        "const char * const EMBEDDED_PYTHON_INTERPRETER = \"" + interpreter + "\";",
        "",
        "//! The runfiles path of the Python home, the folder holding its lib.",
        "extern const char * const EMBEDDED_PYTHON_HOME;",
        "const char * const EMBEDDED_PYTHON_HOME = \"" + home + "\";",
        "",
        "//! The runfiles paths of the folders to add to sys.path, nullptr ended.",
        "extern const char * const EMBEDDED_PYTHON_PATHS[];",
        "const char * const EMBEDDED_PYTHON_PATHS[] = {",
    ] + ["    \"" + path + "\"," for path in imports] + [
        "    nullptr,",
        "};",
        "",
        "} // namespace",
        "",
    ]

    out = ctx.actions.declare_file(ctx.label.name + ".cc")
    ctx.actions.write(out, "\n".join(lines))

    runfiles = ctx.runfiles(transitive_files = runtime.files).merge_all(
        [dep[DefaultInfo].default_runfiles for dep in ctx.attr.deps],
    )

    return [DefaultInfo(files = depset([out]), runfiles = runfiles)]

embedded_python = rule(
    implementation = _embedded_python_impl,
    doc = "Writes the runfiles paths of the Python home and of deps' imports.",
    attrs = {
        "deps": attr.label_list(
            doc = "Python packages the embedded interpreter imports.",
            providers = [PyInfo],
        ),
    },
    toolchains = ["@rules_python//python:toolchain_type"],
)
