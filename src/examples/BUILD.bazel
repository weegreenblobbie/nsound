"""Nsound example programs.

They read and write .wav files in this folder, which they change into when
started with `bazel run` (see run_from_examples_dir.h), for example:

    bazel run //src/examples:mynameis
"""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

[
    cc_binary(
        name = name,
        srcs = [name + ".cc", "run_from_examples_dir.h"],
        deps = ["//src/Nsound:nsound"],
    )
    for name in [
        "bebot",
        "cepstral_pitch_estimate",
        "dynamic_filter",
        "example1",
        "example2",
        "example3",
        "example4",
        "example5",
        "example6",
        "interstellar",
        "mynameis",
        "stretcher",
    ]
]

# bebot.py's synthesizer, apart from its window.
py_library(
    name = "bebot_synth",
    srcs = ["bebot_synth.py"],
    imports = ["."],
    visibility = ["//src/test:__pkg__"],
    deps = ["//src/python:Nsound"],
)

# bebot.py, a synthesizer played with the mouse in a pygame window.  It uses
# the Python module Bazel builds, which plays through portaudio:
#
#     bazel run //src/examples:bebot_py
py_binary(
    name = "bebot_py",
    srcs = ["bebot.py"],
    main = "bebot.py",
    deps = [
        ":bebot_synth",
        "//src/python:Nsound",
        "@nsound_pypi//matplotlib",
        "@nsound_pypi//pygame",
    ],
)
