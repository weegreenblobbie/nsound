"""Nsound C++ unit tests and manual test programs."""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

# main() for the Catch2 tests, runs them next to a copy of the gold files.
cc_library(
    name = "test_main",
    testonly = True,
    srcs = ["catch_main.cc"],
    alwayslink = True,
    deps = ["@catch2//:catch2"],
)

cc_library(
    name = "gold_check",
    testonly = True,
    hdrs = ["gold_check.h"],
    deps = [
        "//src/Nsound:nsound",
        "@catch2//:catch2",
    ],
)

# Plays into a file instead of a sound card.
cc_library(
    name = "playback_capture",
    testonly = True,
    hdrs = ["playback_capture.h"],
    deps = [
        "//src/Nsound:nsound",
        "@catch2//:catch2",
    ],
)

# Checks what Plotter drew, by asking matplotlib.
cc_library(
    name = "plot_check",
    testonly = True,
    hdrs = ["plot_check.h"],
    deps = [
        "//src/Nsound:nsound",
        "@catch2//:catch2",
    ] + select({
        "//bazel:c_pylab_enabled": ["@pybind11"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "filter_signals",
    testonly = True,
    hdrs = ["filter_signals.h"],
    deps = [
        ":plot_check",
        "//src/Nsound:nsound",
    ],
)

# One Catch2 test per class, //src/test:<Class>_test from <Class>_test.cc.
[
    cc_test(
        name = name + "_test",
        srcs = [name + "_test.cc"],
        size = "small",
        # The playback tests all skip where playback can't be captured.
        args = ["--allow-running-no-tests"] if name.startswith("AudioPlayback") else [],
        data = glob(["gold/**"]) + ["alsa_capture.conf"],
        # matplotlib draws into images, it opens no windows.
        env = {"MPLBACKEND": "Agg"},
        deps = [
            ":filter_signals",
            ":gold_check",
            ":playback_capture",
            ":plot_check",
            ":test_main",
            "//src/Nsound:nsound",
            "@catch2//:catch2",
        ],
    )
    for name in [
        "AudioPlayback",
        "AudioPlaybackRt",
        "AudioStream",
        "CircularBuffer",
        "Buffer",
        "BufferWindowSearch",
        "BufferResample",
        "DelayLine",
        "FFTransform",
        "FilterAllPass",
        "FilterBandPassFIR",
        "FilterBandPassIIR",
        "FilterBandPassVocoder",
        "FilterBandRejectFIR",
        "FilterBandRejectIIR",
        "FilterCombLowPassFeedback",
        "FilterDC",
        "FilterDelay",
        "FilterFlanger",
        "FilterIIR",
        "FilterHighPassFIR",
        "FilterHighPassIIR",
        "FilterLeastSquaresFIR",
        "FilterLowPassFIR",
        "FilterLowPassIIR",
        "FilterLowPassMoogVcf",
        "FilterMedian",
        "FilterMovingAverage",
        "FilterParametricEqualizer",
        "FilterPhaser",
        "FilterSlinky",
        "FilterStageIIR",
        "FilterTone",
        "EnvelopeAdsr",
        "Generator",
        "GeneratorDecay",
        "Granulator",
        "Hat",
        "Instruments",
        "Kernel",
        "Mesh2D",
        "Mixer",
        "OrganPipe",
        "Plotter",
        "Pluck",
        "Pulse",
        "ReverberationRoom",
        "Sawtooth",
        "Sine",
        "Spectrogram",
        "Square",
        "Stretcher",
        "Triangle",
        "Utilities",
        "Vocoder",
        "Wavefile",
    ]
]

# Test programs that are run by hand, they are not built by `bazel build //...`.
[
    cc_binary(
        name = name,
        srcs = [name + ".cc", "Test.h"],
        tags = ["manual"],
        deps = ["//src/Nsound:nsound"],
    )
    for name in [
        "test_audio_stream",
        "test_convolve",
        "test_fft",
        "test_filters",
        "test_generators",
        "test_granulator",
        "test_iir_ga",
        "test_mesh",
        "test_mixer",
        "test_moving_average",
        "test_plotter",
        "test_pluck",
        "test_rng",
    ]
]

# The Python module's tests, test_*.py.
[
    py_test(
        name = "py_" + test[:-len(".py")],
        srcs = [
            test,
            "unittest_main.py",
        ],
        # src/test is on the path, the test loads as a top level module.
        args = [test[:-len(".py")]],
        data = glob(["gold/*.wav"]) + ["alsa_capture.conf"],
        env = {"MPLBACKEND": "Agg"},
        imports = ["."],
        main = "unittest_main.py",
        tags = ["python"],
        deps = [
            "//src/python:Nsound",
            "@nsound_pypi//matplotlib",
            "@nsound_pypi//numpy",
        ] + (["//src/examples:bebot_synth"] if test == "test_bebot_synth.py" else []),
    )
    for test in glob(["test_*.py"])
]
