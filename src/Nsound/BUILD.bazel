"""The Nsound C++ library."""

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:embedded_python.bzl", "embedded_python")
load(
    "//:version.bzl",
    "NSOUND_VERSION",
    "NSOUND_VERSION_A",
    "NSOUND_VERSION_B",
    "NSOUND_VERSION_C",
)

# Nsound.h's settings for Linux, macOS or Windows on x86_64 or arm64, little
# endian, 64 bit floats.
# Optional features come from the flags in //bazel.
NSOUND_H_SUBSTITUTIONS = {
    "@PACKAGE_NAME@": "Nsound",
    "@PACKAGE_VERSION_A@": NSOUND_VERSION_A,
    "@PACKAGE_VERSION_B@": NSOUND_VERSION_B,
    "@PACKAGE_VERSION_C@": NSOUND_VERSION_C,
    "@PACKAGE_VERSION@": NSOUND_VERSION,
    "@PACKAGE_RELEASE@": "Nsound-" + NSOUND_VERSION,
    "@NSOUND_ENDIAN@": "NSOUND_LITTLE_ENDIAN",
    "@NSOUND_64_32_BIT@": "#define NSOUND_64_BIT 1",
    "@NSOUND_M_PI@": "// M_PI is defined in math.h",
    "@NSOUND_CUDA@": "#undef NSOUND_CUDA // disabled",
    "@NSOUND_BOOLEAN@": "bool",
    "@NSOUND_INT_8@": "signed char",
    "@NSOUND_INT_16@": "signed short",
    "@NSOUND_INT_32@": "signed int",
    "@NSOUND_INT_64@": "signed long long",
    "@NSOUND_FLOAT_32@": "float",
    "@NSOUND_FLOAT_64@": "double",
    "@NSOUND_U_INT_8@": "unsigned char",
    "@NSOUND_U_INT_16@": "unsigned short",
    "@NSOUND_U_INT_32@": "unsigned int",
    "@NSOUND_U_INT_64@": "unsigned long long",
    "@NSOUND_RAW_INT_64@": "signed long long",
    "@NSOUND_RAW_U_INT_64@": "unsigned long long",
    "@NSOUND_RAW_FLOAT_64@": "double",
} | select({
    "@platforms//os:macos": {"@NSOUND_PLATFORM_OS@": "NSOUND_PLATFORM_OS_MAC"},
    "@platforms//os:windows": {"@NSOUND_PLATFORM_OS@": "NSOUND_PLATFORM_OS_WINDOWS"},
    "//conditions:default": {"@NSOUND_PLATFORM_OS@": "NSOUND_PLATFORM_OS_LINUX"},
}) | select({
    "//bazel:portaudio_enabled": {"@NSOUND_LIBPORTAUDIO@": "#define NSOUND_LIBPORTAUDIO 1"},
    "//conditions:default": {"@NSOUND_LIBPORTAUDIO@": "#undef NSOUND_LIBPORTAUDIO // disabled"},
}) | select({
    "//bazel:openmp_enabled": {"@NSOUND_OPENMP@": "#define NSOUND_OPENMP 1"},
    "//conditions:default": {"@NSOUND_OPENMP@": "#undef NSOUND_OPENMP // disabled"},
})

expand_template(
    name = "nsound_h",
    out = "Nsound.h",
    substitutions = NSOUND_H_SUBSTITUTIONS | {
        "@NSOUND_IN_PYTHON_MODULE@": "// no",
    } | select({
        "//bazel:c_pylab_enabled": {"@NSOUND_C_PYLAB@": "#define NSOUND_C_PYLAB 1"},
        "//conditions:default": {"@NSOUND_C_PYLAB@": "#undef NSOUND_C_PYLAB  // disabled"},
    }),
    template = "Nsound.h.in",
)

# Nsound.h for the Python module, which plots with matplotlib.
expand_template(
    name = "nsound_python_h",
    out = "python/Nsound/Nsound.h",
    substitutions = NSOUND_H_SUBSTITUTIONS | {
        "@NSOUND_IN_PYTHON_MODULE@": "#define NSOUND_IN_PYTHON_MODULE 1",
        "@NSOUND_C_PYLAB@": "#define NSOUND_C_PYLAB 1",
    },
    template = "Nsound.h.in",
)

# Sources compiled only when their feature flag is on.  The CUDA sources
# (*.cu) are not built by Bazel.
PORTAUDIO_SRCS = ["AudioBackendLibportaudio.cc"]

NSOUND_SRCS = glob(
    ["*.cc", "*.cpp"],
    exclude = PORTAUDIO_SRCS,
) + select({
    "//bazel:portaudio_enabled": PORTAUDIO_SRCS,
    "//conditions:default": [],
})

# Nsound.h is excluded in case an old SCons build left it in the source tree.
NSOUND_HDRS = glob(
    ["*.h", "*.hpp"],
    exclude = ["Nsound.h"],
)

NSOUND_COPTS = select({
    "//bazel:openmp_enabled_windows": ["/openmp"],
    "//bazel:openmp_enabled": ["-fopenmp"],
    "//conditions:default": [],
})

NSOUND_LINKOPTS = select({
    "//bazel:openmp_enabled_windows": [],
    "//bazel:openmp_enabled": ["-fopenmp"],
    "//conditions:default": [],
})

NSOUND_DEPS = select({
    "//bazel:portaudio_enabled": ["@portaudio"],
    "//conditions:default": [],
})

# Where Plotter finds Bazel's Python and matplotlib in C++ programs.
embedded_python(
    name = "embedded_python_paths",
    deps = ["@nsound_pypi//matplotlib"],
)

cc_library(
    name = "embedded_python",
    srcs = [":embedded_python_paths"],
    data = [":embedded_python_paths"],
)

cc_library(
    name = "nsound",
    srcs = NSOUND_SRCS,
    hdrs = NSOUND_HDRS + [":nsound_h"],
    # Windows programs declare long path support: Plotter's Python loads
    # numpy from runfiles paths over 260 characters.
    additional_linker_inputs = select({
        "@platforms//os:windows": ["//bazel:long_path_aware.manifest"],
        "//conditions:default": [],
    }),
    copts = NSOUND_COPTS,
    linkopts = NSOUND_LINKOPTS + select({
        "@platforms//os:windows": [
            "/MANIFEST:EMBED",
            "/MANIFESTINPUT:$(location //bazel:long_path_aware.manifest)",
        ],
        "//conditions:default": [],
    }),
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = NSOUND_DEPS + select({
        "//bazel:c_pylab_enabled": [
            ":embedded_python",
            "@pybind11",
            "@rules_cc//cc/runfiles",
            "@rules_python//python/cc:current_py_cc_libs",
        ],
        "//conditions:default": [],
    }),
)

# The Python module's Nsound.h, included as <Nsound/Nsound.h>.
cc_library(
    name = "nsound_python_header",
    hdrs = [":nsound_python_h"],
    strip_include_prefix = "python",
)

# The library built into the Python module, where Plotter uses the Python
# interpreter that loaded it, so it links no Python of its own.
cc_library(
    name = "nsound_python",
    srcs = NSOUND_SRCS,
    hdrs = NSOUND_HDRS,
    copts = NSOUND_COPTS,
    linkopts = NSOUND_LINKOPTS,
    strip_include_prefix = "/src",
    visibility = ["//src/python:__pkg__"],
    deps = NSOUND_DEPS + [
        ":nsound_python_header",
        "@pybind11",
    ],
)
